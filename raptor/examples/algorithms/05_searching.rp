# ==============================================================================
# Mastering Algorithms with Perl — Chapter 05: Searching
# ------------------------------------------------------------------------------
# Implements discrete array, substring, and continuous root-finding searches:
#   1. Linear Search (sequential scan)
#   2. Binary Search Variants (exact, lower_bound, upper_bound, equal_range)
#   3. Interpolation Search (O(log log n) uniform numeric probe)
#   4. Knuth-Morris-Pratt (KMP) Prefix Failure Table + Linear Substring Search
#   5. Boyer-Moore-Horspool (BMH) Bad-Character Shift Substring Search
#   6. Rabin-Karp Rolling Polynomial Hash Substring Search
#   7. Continuous Monotonic Bisection Root Finding
# ==============================================================================

say "=== Chapter 05: Searching ===";

sub arrays_eq(@a, @b) {
    if elems(@a) != elems(@b) {
        return False;
    }
    for 0 ..^ elems(@a) -> $i {
        if @a[$i] != @b[$i] {
            return False;
        }
    }
    return True;
}

# ==============================================================================
# 1. Linear Search
# ==============================================================================

sub linear_search(@arr, $target) {
    my $n = elems(@arr);
    for 0 ..^ $n -> $i {
        if @arr[$i] == $target {
            return $i;
        }
    }
    return -1;
}

my @unsorted = [42, 17, 93, 8, 17, 64, 5];
ASSERT linear_search(@unsorted, 17) == 1, "linear_search finds first occurrence of 17";
ASSERT linear_search(@unsorted, 5) == 6, "linear_search finds last element";
ASSERT linear_search(@unsorted, 999) == -1, "linear_search returns -1 when absent";
ASSERT linear_search([], 1) == -1, "linear_search on empty array";

# ==============================================================================
# 2. Binary Search: Exact, lower_bound (>=), upper_bound (>), count_occurrences
# ==============================================================================

sub lower_bound(@arr, $target) {
    my $lo = 0;
    my $hi = elems(@arr);
    while $lo < $hi {
        my $mid = $lo + (($hi - $lo) div 2);
        if @arr[$mid] < $target {
            $lo = $mid + 1;
        } else {
            $hi = $mid;
        }
    }
    return $lo;
}

sub upper_bound(@arr, $target) {
    my $lo = 0;
    my $hi = elems(@arr);
    while $lo < $hi {
        my $mid = $lo + (($hi - $lo) div 2);
        if @arr[$mid] <= $target {
            $lo = $mid + 1;
        } else {
            $hi = $mid;
        }
    }
    return $lo;
}

sub count_sorted(@arr, $target) {
    return upper_bound(@arr, $target) - lower_bound(@arr, $target);
}

my @dups = [2, 4, 4, 4, 7, 9, 9, 12, 15];
ASSERT lower_bound(@dups, 4) == 1, "lower_bound(4) == 1";
ASSERT upper_bound(@dups, 4) == 4, "upper_bound(4) == 4";
ASSERT count_sorted(@dups, 4) == 3, "count_sorted(4) == 3";
ASSERT lower_bound(@dups, 5) == 4 && upper_bound(@dups, 5) == 4, "bounds on missing value 5";
ASSERT lower_bound(@dups, 0) == 0 && lower_bound(@dups, 99) == 9, "bounds outside array range";
say "[1-2] Linear & Binary Bounds: count(4) in [2,4,4,4,7,9,9,12,15] = " ~ count_sorted(@dups, 4);

# ==============================================================================
# 3. Interpolation Search (O(log log n) on Uniformly Distributed Keys)
# ==============================================================================

sub interpolation_search(@arr, $target) {
    my $lo = 0;
    my $hi = elems(@arr) - 1;
    while $lo <= $hi && $target >= @arr[$lo] && $target <= @arr[$hi] {
        if @arr[$lo] == @arr[$hi] {
            return @arr[$lo] == $target ?? $lo !! -1;
        }
        my $span = @arr[$hi] - @arr[$lo];
        my $pos  = $lo + ((($target - @arr[$lo]) * ($hi - $lo)) div $span);
        if @arr[$pos] == $target {
            return $pos;
        } elsif @arr[$pos] < $target {
            $lo = $pos + 1;
        } else {
            $hi = $pos - 1;
        }
    }
    return -1;
}

my @uniform = [];
for 0 ..^ 200 -> $i {
    push(@uniform, $i * 7 + 3);
}
ASSERT interpolation_search(@uniform, 3) == 0, "interpolation_search first element";
ASSERT interpolation_search(@uniform, 199 * 7 + 3) == 199, "interpolation_search last element";
ASSERT interpolation_search(@uniform, 84 * 7 + 3) == 84, "interpolation_search interior element";
ASSERT interpolation_search(@uniform, 100) == -1, "interpolation_search missing element";
ASSERT interpolation_search([5, 5, 5, 5], 5) == 0, "interpolation_search all-equal plateau";
say "[3] Interpolation Search: found " ~ (84 * 7 + 3) ~ " at index " ~ interpolation_search(@uniform, 84 * 7 + 3);

# ==============================================================================
# 4. Knuth-Morris-Pratt (KMP) Prefix Failure Table & Substring Search
# ==============================================================================

sub kmp_build_lps($pat) {
    my $m = chars($pat);
    my @lps = [];
    for 0 ..^ $m -> $k { push(@lps, 0); }
    my $len = 0;
    my $i   = 1;
    while $i < $m {
        if substr($pat, $i, 1) eq substr($pat, $len, 1) {
            $len = $len + 1;
            @lps[$i] = $len;
            $i = $i + 1;
        } else {
            if $len != 0 {
                $len = @lps[$len - 1];
            } else {
                @lps[$i] = 0;
                $i = $i + 1;
            }
        }
    }
    return @lps;
}

sub kmp_search($text, $pat) {
    my @hits = [];
    my $n = chars($text);
    my $m = chars($pat);
    if $m == 0 || $m > $n {
        return @hits;
    }
    my @lps = kmp_build_lps($pat);
    my $i = 0;
    my $j = 0;
    while $i < $n {
        if substr($text, $i, 1) eq substr($pat, $j, 1) {
            $i = $i + 1;
            $j = $j + 1;
            if $j == $m {
                push(@hits, $i - $j);
                $j = @lps[$j - 1];
            }
        } else {
            if $j != 0 {
                $j = @lps[$j - 1];
            } else {
                $i = $i + 1;
            }
        }
    }
    return @hits;
}

# ==============================================================================
# 5. Boyer-Moore-Horspool (BMH) Bad-Character Shift Substring Search
# ==============================================================================

sub bmh_search($text, $pat) {
    my @hits = [];
    my $n = chars($text);
    my $m = chars($pat);
    if $m == 0 || $m > $n {
        return @hits;
    }
    my %shift = {};
    for 0 ..^ ($m - 1) -> $i {
        %shift{substr($pat, $i, 1)} = $m - 1 - $i;
    }
    my $pos = 0;
    while $pos <= $n - $m {
        my $j = $m - 1;
        while $j >= 0 && substr($text, $pos + $j, 1) eq substr($pat, $j, 1) {
            $j = $j - 1;
        }
        if $j < 0 {
            push(@hits, $pos);
            # Advance by 1 to find all overlapping occurrences consistently
            $pos = $pos + 1;
        } else {
            my $last_ch = substr($text, $pos + $m - 1, 1);
            my $step = exists(%shift, $last_ch) ?? %shift{$last_ch} !! $m;
            $pos = $pos + $step;
        }
    }
    return @hits;
}

# Wait: when BMH finds a match and we want ALL overlapping occurrences OR standard BMH?
# Notice: on mismatch BMH shifts by %shift{$last_ch}! What if a mismatch occurs at j < m-1,
# can %shift{$last_ch} skip an overlapping match? NO! Standard Horspool shifts by
# T[pos + m - 1]'s distance from the end of P[0..m-2], which NEVER skips a valid alignment!
# And on a FULL match (j < 0), shifting by %shift{T[pos + m - 1]} (computed from P[0..m-2]!)
# ALSO never skips any overlapping occurrence! Let's verify that!

# ==============================================================================
# 6. Rabin-Karp Rolling Hash Substring Search
# ==============================================================================

sub rabin_karp_search($text, $pat) {
    my @hits = [];
    my $n = chars($text);
    my $m = chars($pat);
    if $m == 0 || $m > $n {
        return @hits;
    }
    my $base = 257;
    my $mod  = 1000000007;
    my $high = 1;
    for 1 ..^ $m -> $k {
        $high = ($high * $base) % $mod;
    }
    my $ph = 0;
    my $th = 0;
    for 0 ..^ $m -> $i {
        $ph = ($ph * $base + ord(substr($pat, $i, 1))) % $mod;
        $th = ($th * $base + ord(substr($text, $i, 1))) % $mod;
    }
    for 0 .. ($n - $m) -> $i {
        if $ph == $th {
            if substr($text, $i, $m) eq $pat {
                push(@hits, $i);
            }
        }
        if $i < $n - $m {
            my $lead = (ord(substr($text, $i, 1)) * $high) % $mod;
            $th = (($th - $lead + $mod) % $mod * $base + ord(substr($text, $i + $m, 1))) % $mod;
        }
    }
    return @hits;
}

ASSERT arrays_eq(kmp_build_lps("ABABCABAB"), [0, 0, 1, 2, 0, 1, 2, 3, 4]), "KMP LPS table for ABABCABAB";

my $dna = "ABABDABACDABABCABABABABCABAB";
my $pat = "ABABCABAB";
my @h_kmp = kmp_search($dna, $pat);
my @h_bmh = bmh_search($dna, $pat);
my @h_rk  = rabin_karp_search($dna, $pat);
ASSERT arrays_eq(@h_kmp, [10, 19]), "KMP finds overlapping ABABCABAB at [10, 19]";
ASSERT arrays_eq(@h_bmh, @h_kmp), "BMH matches KMP identically";
ASSERT arrays_eq(@h_rk, @h_kmp), "Rabin-Karp matches KMP identically";

# Edge cases: dense overlapping "AAA" in "AAAAAA", single char, no match
ASSERT arrays_eq(kmp_search("AAAAAA", "AAA"), [0, 1, 2, 3]), "KMP dense overlaps";
ASSERT arrays_eq(bmh_search("AAAAAA", "AAA"), [0, 1, 2, 3]), "BMH dense overlaps";
ASSERT arrays_eq(rabin_karp_search("AAAAAA", "AAA"), [0, 1, 2, 3]), "RK dense overlaps";
ASSERT elems(kmp_search("short", "longerpattern")) == 0, "pattern longer than text";
say "[4-6] Substring Search (KMP / BMH / Rabin-Karp): hits for '" ~ $pat ~ "' = [" ~ join(", ", @h_kmp) ~ "]";

# ==============================================================================
# 7. Bisection Root Finding on Continuous Monotonic Functions
# ==============================================================================

sub bisect_root($fn, $lo_in, $hi_in, $tol = 1e-12, $max_iter = 100) {
    my $lo  = num($lo_in);
    my $hi  = num($hi_in);
    my $flo = $fn($lo);
    my $fhi = $fn($hi);
    ASSERT $flo * $fhi <= 0.0, "bisect_root requires opposite signs at bracket endpoints";

    for 1 .. $max_iter -> $iter {
        my $mid  = 0.5 * ($lo + $hi);
        my $fmid = $fn($mid);
        if abs($fmid) <= $tol || ($hi - $lo) * 0.5 <= $tol {
            return $mid;
        }
        if $flo * $fmid <= 0.0 {
            $hi  = $mid;
            $fhi = $fmid;
        } else {
            $lo  = $mid;
            $flo = $fmid;
        }
    }
    return 0.5 * ($lo + $hi);
}

my $root2 = bisect_root(sub ($x) { return $x * $x - 2.0; }, 1.0, 2.0, 1e-13, 120);
my $omega = bisect_root(sub ($x) { return $x * exp($x) - 1.0; }, 0.0, 1.0, 1e-13, 120);
ASSERT abs($root2 - sqrt(2.0)) < 1e-11, "Bisection sqrt(2) accurate to < 1e-11";
ASSERT abs($omega * exp($omega) - 1.0) < 1e-11, "Bisection Lambert W(1) Omega constant accurate to < 1e-11";
say sprintf("[7] Bisection Root Finding: sqrt(2) = %.12f, Omega = %.12f", $root2, $omega);

say "All Chapter 05 assertions passed!";
