# Mastering Algorithms with Perl - Chapter 08: Graphs
# Covers BFS shortest hops, DFS & cycle detection, Kahn's topological sort,
# Tarjan's SCCs, Kruskal & Prim MST, Dijkstra, Bellman-Ford, and Floyd-Warshall.

say "=== Chapter 08: Graphs ===";

# 1. Breadth-First Search (Unweighted Shortest Path)
sub bfs_shortest_path(%adj, $start, $goal) {
    my @q = [$start];
    my %parent = { $start => "" };
    while elems(@q) > 0 {
        my $u = shift(@q);
        if $u eq $goal {
            my @path;
            my $cur = $goal;
            while $cur ne "" {
                unshift(@path, $cur);
                $cur = %parent{$cur};
            }
            return @path;
        }
        my $nbrs = %adj{$u} // [];
        for @$nbrs -> $v {
            if !exists(%parent, $v) {
                %parent{$v} = $u;
                push(@q, $v);
            }
        }
    }
    return [];
}

my %web = {
    "A" => ["B", "C"],
    "B" => ["D", "E"],
    "C" => ["F"],
    "D" => [],
    "E" => ["F"],
    "F" => ["G"],
    "G" => []
};
my @sp = bfs_shortest_path(%web, "A", "G");
ASSERT join("->", @sp) eq "A->C->F->G", "BFS finds shortest 3-hop path A->C->F->G";
say "[1] BFS Shortest Path A..G: {join(' -> ', @sp)}";

# 2. Kahn's Topological Sort & Directed Cycle Detection
sub topo_sort(@nodes, %adj) {
    my %indeg;
    for @nodes -> $u { %indeg{$u} = 0; }
    for @nodes -> $u {
        my $nbrs = %adj{$u} // [];
        for @$nbrs -> $v {
            %indeg{$v} = (%indeg{$v} // 0) + 1;
        }
    }
    my @ready;
    for sort(@nodes) -> $u {
        push(@ready, $u) if %indeg{$u} == 0;
    }
    my @order;
    while elems(@ready) > 0 {
        my $u = shift(@ready);
        push(@order, $u);
        my $nbrs = %adj{$u} // [];
        for sort(@$nbrs) -> $v {
            %indeg{$v} = %indeg{$v} - 1;
            push(@ready, $v) if %indeg{$v} == 0;
        }
    }
    return elems(@order) == elems(@nodes) ?? @order !! [];
}

my @dag_order = topo_sort(qw(compile lex parse codegen link), {
    "lex"     => ["parse"],
    "parse"   => ["compile"],
    "compile" => ["codegen"],
    "codegen" => ["link"],
    "link"    => []
});
ASSERT join(",", @dag_order) eq "lex,parse,compile,codegen,link", "Topological sort on compiler pipeline";
my @cyclic = topo_sort(qw(X Y Z), { "X" => ["Y"], "Y" => ["Z"], "Z" => ["X"] });
ASSERT elems(@cyclic) == 0, "Cycle detected when topo_sort returns empty";
say "[2] Topological Sort: {join(' -> ', @dag_order)}";

# 3. Tarjan's Strongly Connected Components (SCC) — O(V + E)
sub tarjan_scc($n, $adj) {
    my @idx;
    my @low;
    my @on_stack;
    for 0 ..^ $n -> $i {
        push(@idx, -1);
        push(@low, -1);
        push(@on_stack, False);
    }
    my @stack;
    my $timer = 0;
    my @sccs;

    my $dfs;
    $dfs = sub ($u) {
        @idx[$u] = $timer;
        @low[$u] = $timer;
        $timer++;
        push(@stack, $u);
        @on_stack[$u] = True;

        for $adj[$u] -> $v {
            if @idx[$v] == -1 {
                $dfs($v);
                @low[$u] = @low[$v] if @low[$v] < @low[$u];
            } elsif @on_stack[$v] {
                @low[$u] = @idx[$v] if @idx[$v] < @low[$u];
            }
        }

        if @low[$u] == @idx[$u] {
            my @comp;
            while True {
                my $w = pop(@stack);
                @on_stack[$w] = False;
                push(@comp, $w);
                last if $w == $u;
            }
            push(@sccs, sort(@comp));
        }
    };

    for 0 ..^ $n -> $i {
        $dfs($i) if @idx[$i] == -1;
    }
    return @sccs;
}

# Graph: 0->1->2->0 (SCC #1), 2->3, 3->4->3 (SCC #2), 4->5 (SCC #3)
my @scc_list = tarjan_scc(6, [[1], [2], [0, 3], [4], [3, 5], []]);
ASSERT elems(@scc_list) == 3, "Tarjan found 3 SCCs";
say "[3] Tarjan SCC count = {elems(@scc_list)}";

# 4. Minimum Spanning Tree: Kruskal (Union-Find) & Prim — Verify Agreement
sub kruskal_mst($n, @edges) {
    my @parent;
    for 0 ..^ $n -> $i { push(@parent, $i); }
    my $find;
    $find = sub ($x) {
        if @parent[$x] != $x {
            @parent[$x] = $find(@parent[$x]);
        }
        return @parent[$x];
    };
    # Encode edges by weight key for sorting
    my @keyed;
    for 0 ..^ elems(@edges) -> $i {
        my $e = @edges[$i];
        push(@keyed, sprintf("%08d:%d", $e[2], $i));
    }
    my $total_w = 0;
    my $picked  = 0;
    for sort(@keyed) -> $item {
        my $idx = int(split(":", $item)[1]);
        my $e = @edges[$idx];
        my $ru = $find($e[0]);
        my $rv = $find($e[1]);
        if $ru != $rv {
            @parent[$ru] = $rv;
            $total_w += $e[2];
            $picked++;
            last if $picked == $n - 1;
        }
    }
    return $total_w;
}

sub prim_mst($n, @edges) {
    my $INF = 1000000000;
    my @in_mst;
    my @best;
    for 0 ..^ $n -> $i {
        push(@in_mst, False);
        push(@best, $INF);
    }
    @best[0] = 0;
    my $total_w = 0;
    for 0 ..^ $n -> $step {
        my $u = -1;
        for 0 ..^ $n -> $v {
            if !@in_mst[$v] && ($u == -1 || @best[$v] < @best[$u]) {
                $u = $v;
            }
        }
        @in_mst[$u] = True;
        $total_w += @best[$u];
        for @edges -> $e {
            if $e[0] == $u && !@in_mst[$e[1]] && $e[2] < @best[$e[1]] {
                @best[$e[1]] = $e[2];
            } elsif $e[1] == $u && !@in_mst[$e[0]] && $e[2] < @best[$e[0]] {
                @best[$e[0]] = $e[2];
            }
        }
    }
    return $total_w;
}

my @undirected_edges = [
    [0, 1, 4], [0, 2, 3], [1, 2, 1], [1, 3, 2],
    [2, 3, 4], [3, 4, 2], [4, 5, 6], [3, 5, 7]
];
my $w_kruskal = kruskal_mst(6, @undirected_edges);
my $w_prim    = prim_mst(6, @undirected_edges);
ASSERT $w_kruskal == 14 && $w_prim == 14, "Kruskal and Prim agree on MST weight == 14";
say "[4] MST Weight: Kruskal=$w_kruskal, Prim=$w_prim";

# 5. Dijkstra, Bellman-Ford, and Floyd-Warshall Shortest Paths
sub dijkstra($n, $adj_w, $src) {
    my $INF = 1000000000;
    my @dist;
    my @vis;
    for 0 ..^ $n -> $i { push(@dist, $INF); push(@vis, False); }
    @dist[$src] = 0;
    for 0 ..^ $n -> $step {
        my $u = -1;
        for 0 ..^ $n -> $i {
            if !@vis[$i] && ($u == -1 || @dist[$i] < @dist[$u]) {
                $u = $i;
            }
        }
        last if $u == -1 || @dist[$u] == $INF;
        @vis[$u] = True;
        for $adj_w[$u] -> $edge {
            my $v = $edge[0];
            my $w = $edge[1];
            if @dist[$u] + $w < @dist[$v] {
                @dist[$v] = @dist[$u] + $w;
            }
        }
    }
    return @dist;
}

sub bellman_ford($n, @dir_edges, $src) {
    my $INF = 1000000000;
    my @dist;
    for 0 ..^ $n -> $i { push(@dist, $INF); }
    @dist[$src] = 0;
    for 1 ..^ $n -> $iter {
        for @dir_edges -> $e {
            my ($u, $v, $w) = $e;
            if @dist[$u] < $INF && @dist[$u] + $w < @dist[$v] {
                @dist[$v] = @dist[$u] + $w;
            }
        }
    }
    for @dir_edges -> $e {
        my ($u, $v, $w) = $e;
        return [] if @dist[$u] < $INF && @dist[$u] + $w < @dist[$v];
    }
    return @dist;
}

sub floyd_warshall($n, @dir_edges) {
    my $INF = 1000000000;
    my @d;
    for 0 ..^ $n -> $i {
        my @row;
        for 0 ..^ $n -> $j {
            push(@row, $i == $j ?? 0 !! $INF);
        }
        push(@d, @row);
    }
    for @dir_edges -> $e {
        my ($u, $v, $w) = $e;
        @d[$u][$v] = $w if $w < @d[$u][$v];
    }
    for 0 ..^ $n -> $k {
        for 0 ..^ $n -> $i {
            for 0 ..^ $n -> $j {
                if @d[$i][$k] + @d[$k][$j] < @d[$i][$j] {
                    @d[$i][$j] = @d[$i][$k] + @d[$k][$j];
                }
            }
        }
    }
    return @d;
}

my $wgraph = [
    [[1, 10], [2, 3]],
    [[2, 1],  [3, 2]],
    [[1, 4],  [3, 8], [4, 2]],
    [[4, 7]],
    [[3, 9]]
];
my @d_dijk = dijkstra(5, $wgraph, 0);
ASSERT join(",", @d_dijk) eq "0,7,3,9,5", "Dijkstra shortest distances from 0";

my @bf_edges = [[0, 1, 4], [0, 2, 5], [1, 2, -2], [2, 3, 3]];
my @d_bf = bellman_ford(4, @bf_edges, 0);
my @d_fw = floyd_warshall(4, @bf_edges);
ASSERT join(",", @d_bf) eq "0,4,2,5" && @d_fw[0][3] == 5 && @d_fw[1][3] == 1, "Bellman-Ford & Floyd-Warshall with negative edge";
say "[5] Shortest Paths: Dijkstra=[{join(', ', @d_dijk)}], Bellman-Ford=[{join(', ', @d_bf)}]";

say "All Chapter 08 assertions passed!";
