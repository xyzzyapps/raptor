# ==============================================================================
# Raptor ESP32 Embedded Example: I2C OLED Display Controller Packet Driver
# ==============================================================================

# SSD1306 128x64 OLED Display standard I2C address
my $OLED_ADDR = 0x3C;
my $OLED_CMD_STREAM = 0x00;
my $OLED_DATA_STREAM = 0x40;

# Pure Raptor I2C Initialization Packet
my @init_sequence = [
    $OLED_CMD_STREAM,
    0xAE,       # Display OFF
    0xD5, 0x80, # Set Display Clock Divide Ratio
    0xA8, 0x3F, # Set Multiplex Ratio (64 lines)
    0xD3, 0x00, # Set Display Offset
    0x40,       # Set Start Line 0
    0x8D, 0x14, # Enable Charge Pump
    0x20, 0x00, # Set Memory Addressing Mode (Horizontal)
    0xA1,       # Set Segment Re-map
    0xC8,       # Set COM Output Scan Direction
    0xDA, 0x12, # Set COM Pins Hardware Configuration
    0x81, 0xCF, # Set Contrast Control
    0xD9, 0xF1, # Set Pre-charge Period
    0xDB, 0x40, # Set VCOMH Deselect Level
    0xA4,       # Entire Display ON (resume)
    0xA6,       # Set Normal Display (non-inverted)
    0xAF        # Display ON
];

say "Transmitting SSD1306 OLED Initialization packets over I2C to 0x" ~ $OLED_ADDR ~ "...";
my $bytes_written = i2c_write($OLED_ADDR, @init_sequence);
say "I2C Transmission Complete: " ~ $bytes_written ~ " bytes sent.";

# Draw horizontal test bar
my @pixel_bar = [$OLED_DATA_STREAM, 0xFF, 0xFF, 0xFF, 0xFF, 0x00, 0x00, 0xFF, 0xFF];
i2c_write($OLED_ADDR, @pixel_bar);
say "OLED Test Pattern rendered successfully via pure Raptor!";
