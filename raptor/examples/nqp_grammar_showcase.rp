# NQP / QRegex Declarative Grammar Showcase in Raptor
# Demonstrates grammar inheritance (`is`), protoregexes (`proto` + `:sym<...>`),
# LTM (`|`) vs sequential (`||`) alternation, declarative `is optable` precedence,
# separated lists (`%`), goal matching (`~`), lookarounds, and set algebra.

grammar ExprBase {
    token EXPR is optable { <term> }

    proto token term { * }
    token term:sym<int>   { \d+ }
    token term:sym<hex>   { '0x' <xdigit>+ }
    token term:sym<group> { '(' ~ ')' [ <.ws> <EXPR> <.ws> ] }
    token term:sym<ident> { <!before 'let' >> > <[a..z_] + :Lu> \w* }

    proto token prefix { * }
    token prefix:sym<-> is tighter<*> { <sym> }

    proto token infix { * }
    token infix:sym<+>  { <sym> }
    token infix:sym<*>  is tighter<+> { <sym> }
    token infix:sym<**> is tighter<*> is assoc<right> { <sym> }
}

grammar MiniQuery is ExprBase {
    rule TOP { ^ <stmt>+ % ';' ';'? $ }

    proto rule stmt { * }
    rule stmt:sym<let>    { <sym> <name=ident> '=' <val=EXPR> }
    rule stmt:sym<select> { <sym> <cols=col_list> }

    rule col_list { <col=ident> ** 1..* % ',' }
}

my $src = "let total = 0x10 + 2 * 3 ** 2; select alpha, beta, total;";
my $m = MiniQuery.parse($src);

if $m {
    my @stmts = $m{"stmt"};
    say "Statements parsed: " ~ @stmts.elems();
    say "Stmt 1 rule: " ~ @stmts[0]{"rule"} ~ " (lhs=" ~ @stmts[0]{"name"}{"str"} ~ ")";
    my $topOp = @stmts[0]{"val"}{"sym"}{"str"};
    say "Stmt 1 top-level EXPR op: " ~ $topOp;
    say "Stmt 2 rule: " ~ @stmts[1]{"rule"} ~ " (" ~ @stmts[1]{"cols"}{"str"} ~ ")";
}
