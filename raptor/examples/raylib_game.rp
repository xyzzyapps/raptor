# Breakout — Raylib CFFI. Scalars in the hot loop (no per-frame
# struct alloc / infix:<+>) so the interpreter can hold 60 FPS.

struct Color {
    uint8 $r;
    uint8 $g;
    uint8 $b;
    uint8 $a;
}

sub InitWindow(int32 $width, int32 $height, Str $title) returns void is native('libraylib.dll') { * }
sub WindowShouldClose() returns bool is native('libraylib.dll') { * }
sub CloseWindow() returns void is native('libraylib.dll') { * }
sub SetTargetFPS(int32 $fps) returns void is native('libraylib.dll') { * }
sub GetFrameTime() returns num64 is native('libraylib.dll') { * }
sub BeginDrawing() returns void is native('libraylib.dll') { * }
sub EndDrawing() returns void is native('libraylib.dll') { * }
sub ClearBackground(Color $color) returns void is native('libraylib.dll') { * }
sub DrawCircle(int32 $cx, int32 $cy, num64 $r, Color $color) returns void is native('libraylib.dll') { * }
sub DrawRectangle(int32 $x, int32 $y, int32 $w, int32 $h, Color $color) returns void is native('libraylib.dll') { * }
sub DrawText(Str $text, int32 $x, int32 $y, int32 $size, Color $color) returns void is native('libraylib.dll') { * }
sub DrawFPS(int32 $x, int32 $y) returns void is native('libraylib.dll') { * }
sub IsKeyDown(int32 $key) returns bool is native('libraylib.dll') { * }
sub GetMouseX() returns int32 is native('libraylib.dll') { * }

sub mkc($r, $g, $b) {
    my $c = Color.new();
    $c.r = $r; $c.g = $g; $c.b = $b; $c.a = 255;
    return $c;
}

my $W = 900;
my $H = 650;
InitWindow($W, $H, "Raptor Breakout");
SetTargetFPS(60);

my $bg = mkc(15, 23, 42);
my $cyan = mkc(56, 189, 248);
my $mag = mkc(244, 63, 94);
my $yel = mkc(250, 204, 21);
my $grn = mkc(74, 222, 128);
my $wht = mkc(248, 250, 252);

my $bx = 450.0;
my $by = 280.0;
my $vx = 260.0;
my $vy = 200.0;
my $br = 12.0;
my $pw = 140.0;
my $ph = 16.0;
my $px = 380.0;
my $score = 0;
my $lives = 3;

# Precomputed brick rectangles (8 x 4)
my $nb = 32;
my @alive = [];
my @rx = [];
my @ry = [];
loop (my $i = 0; $i < 32; $i += 1) {
    push(@alive, 1);
    my $col = $i - 8 * ($i / 8);
    my $row = $i / 8;
    push(@rx, 42.0 + $col * 105.0);
    push(@ry, 72.0 + $row * 28.0);
}

say "Breakout: mouse / arrows. Close the window to quit.";

while !WindowShouldClose() {
    my $dt = GetFrameTime();
    if $dt <= 0.0 || $dt > 0.05 { $dt = 0.016; }

    my $mx = GetMouseX();
    if $mx > 0 && $mx < $W { $px = $mx - 70.0; }
    if IsKeyDown(263) { $px = $px - 480.0 * $dt; }
    if IsKeyDown(262) { $px = $px + 480.0 * $dt; }
    if $px < 8.0 { $px = 8.0; }
    if $px > 752.0 { $px = 752.0; }

    $bx = $bx + $vx * $dt;
    $by = $by + $vy * $dt;

    if $bx < $br || $bx > 888.0 { $vx = 0 - $vx; }
    if $by < $br { $vy = 0 - $vy; }

    if $by >= 600.0 && $by <= 628.0 && $bx >= $px && $bx <= $px + $pw {
        $vy = 0 - abs($vy);
        $score = $score + 5;
    }

    loop (my $j = 0; $j < 32; $j += 1) {
        if @alive[$j] == 1 {
            my $x = @rx[$j];
            my $y = @ry[$j];
            if $bx + $br > $x && $bx - $br < $x + 96.0 && $by + $br > $y && $by - $br < $y + 22.0 {
                @alive[$j] = 0;
                $vy = 0 - $vy;
                $score = $score + 15;
            }
        }
    }

    if $by > $H {
        $lives = $lives - 1;
        $bx = 450.0;
        $by = 280.0;
        $vy = 200.0;
        if $lives <= 0 {
            $score = 0;
            $lives = 3;
            loop (my $k = 0; $k < 32; $k += 1) {
                @alive[$k] = 1;
            }
        }
    }

    BeginDrawing();
    ClearBackground($bg);
    DrawText("RAPTOR BREAKOUT", 20, 16, 26, $cyan);
    DrawText("Score " ~ $score ~ "  Lives " ~ $lives, 620, 18, 20, $yel);

    loop (my $d = 0; $d < 32; $d += 1) {
        if @alive[$d] == 1 {
            DrawRectangle(@rx[$d], @ry[$d], 96, 22, $yel);
        }
    }
    DrawRectangle($px, 614, $pw, $ph, $grn);
    DrawCircle($bx, $by, $br, $mag);
    DrawFPS(20, 624);
    EndDrawing();
}

CloseWindow();
say "Game closed. Score $score";
