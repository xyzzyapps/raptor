# ==============================================================================
# Charm / Lip Gloss Terminal Styling & TUI Library for Raptor (.rp)
# ==============================================================================

# Style text with ANSI foreground, background, borders, and typography
sub style($text, %opts = {}) {
    return tui_style($text, %opts);
}

# Create a framed box
sub box($text, %opts = {}) {
    return tui_box($text, %opts);
}

# Create a styled ASCII/Unicode table
sub table(@headers, @rows, %opts = {}) {
    return tui_table(@headers, @rows, %opts);
}

# Create a progress bar (0.0 to 1.0 or 0 to 100)
sub progress($percent, %opts = {}) {
    return tui_progress($percent, %opts);
}

# Render markdown in the terminal
sub markdown($md_text) {
    return tui_markdown($md_text);
}

# Clear terminal screen
sub clear_screen() {
    return tui_clear();
}

# Run Elm-style Bubble Tea interactive state machine application
sub run_app(%app_spec) {
    return tui_app_run(%app_spec);
}
