# ==============================================================================
# Test::More - Perl5/Raku Standard TAP Test Framework for Raptor (.rp)
# ==============================================================================

# Plan total tests upfront: plan(10);
sub plan($count) {
    return plan($count);
}

# Test boolean truth: ok($res == 42, "computed correct answer");
sub ok($condition, $name = "") {
    return ok($condition, $name);
}

# Test equality: is($got, $expected, "equality description");
sub is($got, $expected, $name = "") {
    return is($got, $expected, $name);
}

# Test inequality: isnt($got, $expected, "inequality description");
sub isnt($got, $expected, $name = "") {
    return isnt($got, $expected, $name);
}

# Deep structural equality: is_deeply([1, 2, {:a => 10}], [1, 2, {:a => 10}], "structures match");
sub is_deeply($got, $expected, $name = "") {
    return is_deeply($got, $expected, $name);
}

# Regex pattern match: like($str, "^[a-z]+$", "only lowercase");
sub like($got, $regex, $name = "") {
    return like($got, $regex, $name);
}

# Regex pattern non-match: unlike($str, "[0-9]", "contains no digits");
sub unlike($got, $regex, $name = "") {
    return unlike($got, $regex, $name);
}

# Generic operator comparison: cmp_ok($a, ">=", $b, "a is at least b");
sub cmp_ok($got, $op, $expected, $name = "") {
    return cmp_ok($got, $op, $expected, $name);
}

# Unconditional pass: pass("feature works");
sub pass($name = "") {
    return pass($name);
}

# Unconditional fail: fail("should not reach here");
sub fail($name = "") {
    return fail($name);
}

# Diagnostic message: diag("debug info");
sub diag($msg) {
    return diag($msg);
}

# Subtest block: subtest "Math Operations", sub () { ok(1 + 1 == 2); is(2 * 3, 6); };
sub subtest($name, $closure) {
    return subtest($name, $closure);
}

# Complete test suite: done_testing();
sub done_testing($count = 0) {
    return done_testing($count);
}
